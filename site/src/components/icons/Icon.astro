---
/**
 * The landing page's line glyphs, kept in one place so the templates stay
 * markup-only. Every glyph inherits `currentColor`.
 */
interface Props {
	name: 'menu' | 'close' | 'chevron' | 'hub' | 'route' | 'box';
	size?: number;
	class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const PATHS: Record<Props['name'], string> = {
	menu: '<path d="M3 6h14M3 10h14M3 14h14" />',
	close: '<path d="M5 5l10 10M15 5L5 15" />',
	chevron: '<path d="M5 8l5 5 5-5" />',
	hub: '<path d="M2 8h12M8 2v12" /><circle cx="8" cy="8" r="5.5" />',
	route: '<path d="M2 5h5l2 3 5 0M2 11h5l2-3" /><circle cx="13.2" cy="8" r="1.6" />',
	box: '<rect x="2.5" y="2.5" width="11" height="11" rx="2" /><path d="M5.5 5.5v5h5" />',
};

// The marquee glyphs are drawn on a 16-unit grid with a lighter stroke.
const small = name === 'hub' || name === 'route' || name === 'box';
---

<svg
	class={className}
	width={small ? 16 : size}
	height={small ? 16 : size}
	viewBox={small ? '0 0 16 16' : '0 0 20 20'}
	fill="none"
	stroke="currentColor"
	stroke-width={small ? 1.3 : 1.5}
	aria-hidden="true"
	set:html={PATHS[name]}
/>
