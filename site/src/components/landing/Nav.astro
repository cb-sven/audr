---
import Icon from '../icons/Icon.astro';

interface Props {
	wordmark: string;
	suffix: string;
	links: { label: string; href: string; external?: boolean }[];
}

const { wordmark, suffix, links } = Astro.props;
---

<nav class="nav" data-open="false">
  <div class="nav-inner">
    <a class="nav-mark" href="#" aria-label={`${wordmark} home`}>
      <svg
        class="mark-icon"
        viewBox="0 0 256 256"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M126.796 179.104C129.063 169.899 135.758 165.297 146.88 165.297H186.399C190.178 165.297 193.256 164.739 195.631 163.623C198.114 162.414 199.356 160.508 199.356 157.905V148.002H204.539V153.163C204.539 159.857 203.297 165.25 200.814 169.341C198.438 173.339 193.687 175.338 186.561 175.338L142.345 175.338C137.27 175.338 133.868 176.036 132.141 177.43C130.305 178.732 129.387 181.057 129.387 184.404V190.82H124.205V184.404C124.205 181.057 123.341 178.732 121.613 177.43C119.778 176.036 116.322 175.338 111.247 175.338H67.1929C60.0665 175.338 55.3155 173.339 52.94 169.341C50.4566 165.25 49.2149 159.857 49.2149 153.163V148.002H54.3977L54.3977 157.905C54.3977 160.601 55.4235 162.507 57.4751 163.623C59.4186 164.739 62.172 165.297 65.7353 165.297L106.712 165.297C117.834 165.297 124.528 169.899 126.796 179.104Z"
          fill="#0D2A1A"
        />
        <path
          d="M126.796 83.3658C129.063 74.1609 135.758 69.5584 146.88 69.5584H186.399C190.178 69.5584 193.256 69.0005 195.631 67.8847C198.114 66.676 199.356 64.7699 199.356 62.1665V52.2642H204.539V57.4245C204.539 64.1191 203.297 69.5119 200.814 73.603C198.438 77.6011 193.687 79.6002 186.561 79.6002L142.345 79.6002C137.27 79.6002 133.868 80.2975 132.141 81.6922C130.305 82.9939 129.387 85.3184 129.387 88.6657V95.0813H124.205V88.6657C124.205 85.3184 123.341 82.9939 121.613 81.6922C119.778 80.2975 116.322 79.6002 111.247 79.6002H67.1929C60.0665 79.6002 55.3155 77.6011 52.94 73.603C50.4566 69.5119 49.2149 64.1191 49.2149 57.4245V52.2642H54.3977L54.3977 62.1665C54.3977 64.8629 55.4235 66.769 57.4751 67.8847C59.4186 69.0005 62.172 69.5584 65.7353 69.5584L106.712 69.5584C117.834 69.5584 124.528 74.1609 126.796 83.3658Z"
          fill="#0D2A1A"
        />
        <line
          x1="118.176"
          y1="108.096"
          x2="62.1719"
          y2="108.096"
          stroke="#0D2A1A"
          stroke-width="10"
        />
        <line
          x1="192.91"
          y1="108.096"
          x2="136.906"
          y2="108.096"
          stroke="#0D2A1A"
          stroke-width="10"
        />
        <line
          x1="118.176"
          y1="138.096"
          x2="62.1719"
          y2="138.096"
          stroke="#0D2A1A"
          stroke-width="10"
        />
        <line
          x1="192.91"
          y1="138.096"
          x2="136.906"
          y2="138.096"
          stroke="#0D2A1A"
          stroke-width="10"
        />
      </svg>
      {wordmark} <span>{suffix}</span>
    </a>
    <button
      class="nav-toggle"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <Icon name="menu" class="icon-open" />
      <Icon name="close" class="icon-close" />
    </button>
    <div class="nav-links" id="nav-links">
      {
        links.map((link) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>
